[Unit]
Description=Pi-hole Parental Controls Scheduler
Documentation=https://docs.pi-hole.net
After=pihole-FTL.service network-online.target
Wants=network-online.target
Requires=pihole-FTL.service

[Service]
Type=simple
User=pihole
Group=pihole

# Main service executable
ExecStart=/opt/pihole/parental-scheduler.sh start
ExecStop=/opt/pihole/parental-scheduler.sh stop

# Restart policy
Restart=on-failure
RestartSec=10s

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/pihole /var/log/pihole /run/pihole

# Process settings
Nice=5
IOSchedulingClass=idle
IOSchedulingPriority=7

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pihole-parental

[Install]
WantedBy=multi-user.target
